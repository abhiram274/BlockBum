/* BlockBum Desktop Core - Official Qt Stylesheet
 * Palette: Obsidian Black, Imperial Gold, Radiant Orange, Crisp White
 */

QMainWindow {
    background-color: #0A0A0E;
    color: #FFFFFF;
}

QWidget {
    background-color: #0A0A0E;
    color: #FFFFFF;
    font-family: "Segoe UI", -apple-system, "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

/* Menu Bar */
QMenuBar {
    background-color: #121218;
    color: #F8FAFC;
    border-bottom: 1px solid #2A2418;
    padding: 2px 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #FF8800;
    color: #FFFFFF;
}

QMenu {
    background-color: #161622;
    color: #FFFFFF;
    border: 1px solid #D4AF37;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 16px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #FF6B00;
    color: #FFFFFF;
}

/* ToolBar */
QToolBar {
    background-color: #121218;
    border-bottom: 2px solid #FFB800;
    spacing: 6px;
    padding: 4px 8px;
}

QToolButton {
    background-color: #1A1A26;
    color: #FFFFFF;
    border: 1px solid #3A3220;
    border-radius: 5px;
    padding: 6px 14px;
    font-weight: 600;
}

QToolButton:hover {
    background-color: #2A2418;
    border: 1px solid #FFB800;
    color: #FFD700;
}

QToolButton:checked {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #FF8800, stop:1 #FF5500);
    border: 1px solid #FFB800;
    color: #FFFFFF;
}

/* Status Bar */
QStatusBar {
    background-color: #0D0D12;
    color: #E2E8F0;
    border-top: 1px solid #2A2418;
}

QStatusBar QLabel {
    color: #E2E8F0;
    padding: 2px 8px;
}

/* Buttons */
QPushButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #FF8800, stop:1 #FF5500);
    color: #FFFFFF;
    border: 1px solid #FFB800;
    border-radius: 5px;
    padding: 8px 18px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #FFA333, stop:1 #FF6B00);
    border: 1px solid #FFE259;
}

QPushButton:pressed {
    background-color: #D45500;
}

QPushButton:disabled {
    background-color: #2A2A38;
    color: #64748B;
    border: 1px solid #3F3F50;
}

/* Secondary Button (Gold outline) */
QPushButton#goldBtn {
    background-color: #1A1A26;
    color: #FFD700;
    border: 1px solid #FFB800;
}

QPushButton#goldBtn:hover {
    background-color: #2D2310;
    border: 1px solid #FFE259;
}

/* Input Fields */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #14141E;
    color: #FFFFFF;
    border: 1px solid #3A3220;
    border-radius: 4px;
    padding: 6px 10px;
    selection-background-color: #FF8800;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #FFB800;
    background-color: #181824;
}

/* Tables and Lists */
QTableWidget, QTableView, QListWidget, QListView {
    background-color: #121218;
    color: #FFFFFF;
    gridline-color: #24221A;
    border: 1px solid #3A3220;
    border-radius: 4px;
    selection-background-color: #2A2210;
    selection-color: #FFD700;
}

QHeaderView::section {
    background-color: #181822;
    color: #FFB800;
    padding: 6px 10px;
    border: 1px solid #2A2418;
    font-weight: bold;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #3A3220;
    background-color: #121218;
    border-radius: 4px;
}

QTabBar::tab {
    background-color: #181822;
    color: #94A3B8;
    padding: 8px 18px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border: 1px solid #2A2418;
}

QTabBar::tab:selected {
    background-color: #121218;
    color: #FFD700;
    border-bottom: 2px solid #FF8800;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    color: #FFFFFF;
    background-color: #22202A;
}

/* Labels */
QLabel#heroBalance {
    color: #FFD700;
    font-size: 32px;
    font-weight: bold;
}

QLabel#sectionTitle {
    color: #FFFFFF;
    font-size: 18px;
    font-weight: bold;
}

QLabel#networkPill {
    background-color: #1F190D;
    color: #FFB800;
    border: 1px solid #D4AF37;
    border-radius: 12px;
    padding: 3px 10px;
    font-weight: 600;
}
