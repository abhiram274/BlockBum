{
  "name": "blockbum-community-ui",
  "version": "0.2.0",
  "private": true,
  "description": "BlockBum Decentralized Community Platform & Cross-Platform Desktop Client",
  "main": "electron-main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "npm run build && electron .",
    "start:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "dist": "npm run build && electron-builder --win",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "dist:all": "npm run build && electron-builder -mwl"
  },
  "build": {
    "appId": "network.blockbum.desktop",
    "productName": "BlockBum",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "maintainer": "BlockBum Open Source Core Guild <core@blockbum.net>"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.social-networking",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "publish": {
      "provider": "generic",
      "url": "https://releases.blockbum.net/updates"
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.7",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "wait-on": "^9.5.1"
  }
}
